{
  "manifest_version": 3,
  "name": "蒙古实况互动地图高度调整",
  "version": "1.0.0",
  "description": "在蒙古天气实况页面扩展互动地图的可视高度。",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "显示/隐藏蒙古实况地图控制面板"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weather.gov.mn/observation/weather*",
        "https://*.weather.gov.mn/observation/weather*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
